# Chunk package temporary files
.chunk_downloads_*/

# Release package files (upload to GitHub Releases instead of Git)
# Assets are downloaded directly to releases/ directory
# Developers use upload_to_release.sh to upload these files
releases/*.tar.gz
releases/*.tar
releases/*.json
releases/*.merge.sh
releases/*.part*
releases/*.sha256
releases/*.bak
releases/chunks/
!releases/.gitkeep

# UeSim Linux runtime (large binaries, download from releases)
src/UeSim/Linux/

# Dynamic maps (large .bin files, download from releases)
dynamicmaps/*.bin

# MuJoCo robot models (generated/downloaded at install)
src/robot_mujoco/

# Build artifacts
*.log
*.tmp
bin/*.log
bin/log.txt
bin/sim_launcher.bin

# Build directories
**/build/
**/build_*/
**/*.bak.*/

# Runtime logs
**/run_*.log
**/*_ue.log

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
